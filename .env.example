# ---------------------------------------------------------------------
#  Mon Amour
#
#  Copy to .env.local and fill in. Without the first two the app still
#  runs — it opens in "atelier mode", keeping the wardrobe in this
#  browser only. The extension needs real Supabase keys to save into.
# ---------------------------------------------------------------------

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
#  Price tracking (optional)
#
#  The scheduled tracker re-reads prices for every wardrobe, which
#  row-level security correctly forbids the anon key from doing — so it
#  needs the service role key. Server-side only: never prefix it with
#  NEXT_PUBLIC_, and never commit the real value.
#
#  Supabase → Project Settings → API → service_role
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel Cron sends it as a bearer token so the
# tracker endpoint cannot be triggered by anyone else.
#   node -e "console.log(crypto.randomUUID())"
CRON_SECRET=
