{
  "manifest_version": 3,
  "name": "Mon Amour — Wardrobe Collector",
  "short_name": "Mon Amour",
  "version": "1.0.0",
  "description": "Save a whole cart from Myntra or Savana straight into her Mon Amour wardrobe.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Mon Amour",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://miamor.sbs/*",
    "https://www.miamor.sbs/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.myntra.com/*",
    "*://*.savana.com/*",
    "*://*.savana.in/*",
    "*://*.zara.com/*",
    "*://*.hm.com/*",
    "*://*.ajio.com/*",
    "*://*.nykaa.com/*",
    "*://*.nykaafashion.com/*",
    "*://*.urbanic.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.myntra.com/*",
        "*://*.savana.com/*",
        "*://*.savana.in/*",
        "*://*.zara.com/*",
        "*://*.hm.com/*",
        "*://*.ajio.com/*",
        "*://*.nykaa.com/*",
        "*://*.nykaafashion.com/*",
        "*://*.urbanic.com/*"
      ],
      "js": ["content/adapters.js", "content/collect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://miamor.sbs/*",
        "https://www.miamor.sbs/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/session-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
